diff --git a/scalecua_rl/controller/internal/controller/start_cancel_test.go b/scalecua_rl/controller/internal/controller/start_cancel_test.go
new file mode 100644
index 0000000..951cec2
--- /dev/null
+++ b/scalecua_rl/controller/internal/controller/start_cancel_test.go
@@ -0,0 +1,101 @@
+package controller
+
+import (
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/labstack/echo/v4"
+	"github.com/thudm/agentrl/controller/internal/types"
+	"github.com/thudm/agentrl/controller/internal/utils"
+	"go.uber.org/zap"
+)
+
+func TestStartTimeoutKeepsSlotUntilCancelNotice(t *testing.T) {
+	notice := make(chan struct{})
+	registered := make(chan struct{}, 1)
+	var reject atomic.Bool
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/get_sessions":
+			_, _ = w.Write([]byte("{}"))
+			registered <- struct{}{}
+		case "/start_sample":
+			if reject.Load() {
+				w.WriteHeader(http.StatusNotAcceptable)
+				return
+			}
+			// Consume the request so net/http observes the client disconnect.
+			var request WorkerStartSampleRequest
+			if err := json.NewDecoder(r.Body).Decode(&request); err != nil {
+				t.Error(err)
+			}
+			select {
+			case <-r.Context().Done():
+			case <-time.After(2 * time.Second):
+			}
+		case "/cancel_with_notice":
+			close(notice)
+			_, _ = w.Write([]byte("null"))
+		default:
+			t.Errorf("unexpected request to %s", r.URL.Path)
+		}
+	}))
+	defer server.Close()
+
+	c := &Controller{Logger: zap.NewNop().Sugar(), Transport: utils.NewTransport(),
+		HeartbeatTimeout: time.Minute, StartTimeout: 100 * time.Millisecond, InteractionTimeout: time.Minute}
+	c.TaskManager = c.NewTaskManager()
+	c.SessionManager = c.NewSessionsManager()
+	indices := []types.TaskIndex{{Value: "example"}}
+	if _, err := c.TaskManager.CreateOrValidateTask("test", indices); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := c.TaskManager.UpdateWorker("test", server.URL, 1, nil); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-registered:
+	case <-time.After(time.Second):
+		t.Fatal("worker did not register")
+	}
+	e := echo.New()
+	start := func() error {
+		req := httptest.NewRequest(http.MethodPost, "/api/start_sample",
+			strings.NewReader(`{"name":"test","index":"example"}`))
+		req.Header.Set(echo.HeaderContentType, echo.MIMEApplicationJSON)
+		return c.handleStartSample(e.NewContext(req, httptest.NewRecorder()))
+	}
+	if err := start(); err == nil {
+		t.Fatal("expected startup timeout")
+	}
+	select {
+	case <-notice:
+	case <-time.After(time.Second):
+		t.Fatal("worker did not receive a cancellation request")
+	}
+	if _, err := c.TaskManager.DispatchTask("test", indices[0], nil); err == nil {
+		t.Fatal("slot reused while cancellation was pending")
+	}
+	if err := c.handleCancelNoticeGeneric(1); err != nil {
+		t.Fatal(err)
+	}
+	reject.Store(true)
+	var busy *echo.HTTPError
+	if err := start(); !errors.As(err, &busy) || busy.Code != http.StatusServiceUnavailable {
+		t.Fatalf("worker admission rejection returned %v", err)
+	}
+	select {
+	case <-registered:
+	case <-time.After(time.Second):
+		t.Fatal("worker inventory was not reconciled after rejecting admission")
+	}
+	if _, err := c.TaskManager.DispatchTask("test", indices[0], nil); err != nil {
+		t.Fatal("acknowledged slot was not released:", err)
+	}
+}
